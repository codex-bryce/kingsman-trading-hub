# Build-time configuration for local development and Vercel.
APP_ENV=production
REF_NAME=local

# Optional translations and remote configuration
TRANSLATIONS_CDN_URL=https://translations.deriv.com
R2_PROJECT_NAME=deriv-app
CROWDIN_BRANCH_NAME=master
REMOTE_CONFIG_URL=
REMOTE_CONFIG_URL_STAGING=
REMOTE_CONFIG_URL_PROD=

# Supabase (required only for Supabase-backed features)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Google Drive integration (required only for Google Drive features)
GD_CLIENT_ID=
GD_APP_ID=
GD_API_KEY=

# Optional monitoring and analytics
TRACKJS_TOKEN=
DATADOG_SESSION_REPLAY_SAMPLE_RATE=1
DATADOG_SESSION_SAMPLE_RATE=10
DATADOG_APPLICATION_ID=
DATADOG_CLIENT_TOKEN=
RUDDERSTACK_KEY=
GROWTHBOOK_CLIENT_KEY=
GROWTHBOOK_DECRYPTION_KEY=

# Optional Deriv OAuth overrides
DERIV_OPTIONS_OAUTH_APP_ID=
DERIV_OPTIONS_PAT_APP_ID=
